global:
  checkNewVersion: false
  sendAnonymousUsage: false
log:
  level: DEBUG
api:
  dashboard: true
  insecure: true
entryPoints:
  web:
    address: :80
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
  websecure:
    address: :443
providers:
  docker:
    endpoint: "unix://var/run/docker.sock"
    exposedByDefault: false
tls:
  stores:
    default:
      defaultGeneratedCert:
        resolver: desec
        domain:
          main: {{ domain }}
          sans:
            - .*{{domain}}
certificatesResolvers:
  desec:
    acme:
      email: {{ email }}
      storage: /var/traefik/certs/desec.json
      dnsChallenge:
        provider: desec
        disablePropagationCheck: true
        delayBeforeCheck: 60
        resolvers:
          - "ns1.desec.io:53"
          - "ns2.desec.org:53"
          - "8.8.8.8:53" # Google
          - "8.8.4.4:53" # Google
          - "1.1.1.1:53" # Cloudflare
          - "1.0.0.1:53" # Cloudflare
