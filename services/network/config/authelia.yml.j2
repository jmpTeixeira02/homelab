theme: dark

server:
  address: tcp://0.0.0.0:9091

log:
  level: info

authentication_backend:
  file:
    path: /config/users.yml
    password:
      algorithm: argon2id

session:
  cookies:
    - domain: {{ DOMAIN }}
      authelia_url: https://auth.{{ DOMAIN }}
      default_redirection_url: https://homepage.{{ DOMAIN }}
      expiration: 1h
      inactivity: 5m

storage:
  local:
    path: /config/db.sqlite3

notifier:
  filesystem:
    filename: /config/notifications.txt

access_control:
  default_policy: deny
  rules:
    - domain: auth.{{ DOMAIN }}
      policy: bypass
    - domain: "*.{{DOMAIN}}"
      policy: one_factor
